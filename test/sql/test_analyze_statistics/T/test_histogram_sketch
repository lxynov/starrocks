-- Enough rows for the sketches to have to approximate, spread over several tablets so that partial sketches
-- are merged. Half of the rows of k_skew hold one of two values; k_uni is unique.
CREATE TABLE `t3` (
    `id` bigint,
    `k_skew` int,
    `k_uni` bigint,
    `k_str` varchar(20)
)
DISTRIBUTED BY HASH(`id`) BUCKETS 4
PROPERTIES ('replication_num' = '1');

INSERT INTO t3
SELECT generate_series,
       CASE WHEN generate_series % 10 < 4 THEN 7 WHEN generate_series % 10 = 4 THEN 13 ELSE 100 + generate_series % 5000 END,
       (generate_series * 7919) % 200000,
       concat('v', CASE WHEN generate_series % 5 = 0 THEN 0 ELSE generate_series % 3000 END)
FROM TABLE(generate_series(1, 200000));
[UC] ANALYZE FULL TABLE t3;
[UC] ANALYZE FULL TABLE t3 UPDATE HISTOGRAM ON k_skew, k_uni, k_str PROPERTIES('histogram_collect_mode' = 'sketch', 'histogram_collect_bucket_ndv_mode' = 'hll');

-- The most common values of a column that gets buckets are counted exactly.
SELECT mcv FROM _statistics_.histogram_statistics WHERE table_name = 'analyze_test_${uuid0}.t3' AND column_name = 'k_skew';
-- Those of a string column come from the sketch alone: 40000 rows hold v0, give or take the sketch's error.
SELECT get_json_string(mcv, '$[0][0]'), abs(cast(get_json_string(mcv, '$[0][1]') AS bigint) - 40000) <= 200000 * 3.5 / 2048, json_length(parse_json(mcv))
FROM _statistics_.histogram_statistics WHERE table_name = 'analyze_test_${uuid0}.t3' AND column_name = 'k_str';
-- k_uni holds each of 0 to 199999 once, so the rows at or below a bound are the bound plus one. Every bucket's
-- cumulative count is within 2% of the rows of that, about three times the sketch's rank error, and its
-- distinct count within a fifth of its rows.
WITH h AS (
    SELECT parse_json(buckets) AS j FROM _statistics_.histogram_statistics WHERE table_name = 'analyze_test_${uuid0}.t3' AND column_name = 'k_uni'
), b AS (
    SELECT cast(get_json_string(e.value, '$[1]') AS bigint) AS upper, cast(get_json_string(e.value, '$[2]') AS bigint) AS cnt,
           cast(get_json_string(e.value, '$[4]') AS bigint) AS ndv
    FROM h, json_each(h.j) AS e
)
SELECT count(*), max(cnt), max(abs(cnt - (upper + 1))) < 4000, min(ndv) > 2000, max(ndv) < 4500 FROM b;
-- The buckets of k_skew cover the 100000 rows outside its two most common values, which hold 2500 values.
WITH h AS (
    SELECT parse_json(buckets) AS j FROM _statistics_.histogram_statistics WHERE table_name = 'analyze_test_${uuid0}.t3' AND column_name = 'k_skew'
), b AS (
    SELECT cast(get_json_string(e.value, '$[2]') AS bigint) AS cnt, cast(get_json_string(e.value, '$[4]') AS bigint) AS ndv
    FROM h, json_each(h.j) AS e
)
SELECT count(*) BETWEEN 60 AND 64, max(cnt), sum(ndv) BETWEEN 2300 AND 2700 FROM b;

