)
SELECT date_add('2020-01-01', s1.g1), s1.g1, concat('s', s1.g1), s1.g1 / 4,
       date_add('2020-01-01 00:00:00', interval s1.g1 hour), s1.g1 / 8, s1.g1 % 3 = 0
