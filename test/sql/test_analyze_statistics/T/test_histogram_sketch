-- name: test_histogram_sketch

create database analyze_test_${uuid0};
use analyze_test_${uuid0};

CREATE TABLE `t1` (
    `k1` date,
    `k2` int,
    `k3` varchar(20),
    `k4` decimal(10, 2),
    `k5` datetime,
    `k6` double,
    `k7` boolean
)
PROPERTIES ('replication_num' = '1');

-- Skewed: the value i of k2 is held by 120 / i rows, rounded down, and the other columns follow k2.
INSERT INTO t1
WITH series AS (
    SELECT g1 FROM TABLE(generate_series(1, 120)) AS t(g1)
)
SELECT date_add('2020-01-01', s1.g1), s1.g1, concat('s', s1.g1), s1.g1 / 4,
       date_add('2020-01-01 00:00:00', interval s1.g1 hour), s1.g1 / 8, s1.g1 % 3 = 0
FROM series s1, series s2
WHERE s2.g1 <= 120 / s1.g1;
INSERT INTO t1 VALUES (NULL, NULL, NULL, NULL, NULL, NULL, NULL);

SELECT count(*), count(k2), count(DISTINCT k2) FROM t1;
SELECT k2, count(*) FROM t1 GROUP BY k2 ORDER BY count(*) DESC, k2 LIMIT 12;

[UC] ANALYZE FULL TABLE t1;

-- Sketch mode. A value is a most common value only if it is held by at least twice the rows an evenly spread
-- column would give it: 602 rows over 120 values is 5 rows a value, so the values 1 to 10 qualify. Every
-- other row goes to the buckets. With no more rows than the sketches keep exactly, the result is exact.
[UC] ANALYZE TABLE t1 UPDATE HISTOGRAM ON k1,k2,k3,k4,k5,k6,k7 PROPERTIES('histogram_sample_ratio' = '1.0', 'histogram_collect_mode' = 'sketch');
SELECT column_name, mcv FROM _statistics_.histogram_statistics WHERE table_name = 'analyze_test_${uuid0}.t1' ORDER BY column_name;
SELECT column_name, buckets FROM _statistics_.histogram_statistics WHERE table_name = 'analyze_test_${uuid0}.t1' AND column_name IN ('k2', 'k3', 'k4', 'k7') ORDER BY column_name;
-- One query finds the most common values of the six fixed-size columns, one those of the string column, and
