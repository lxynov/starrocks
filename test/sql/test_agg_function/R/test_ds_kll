-- name: test_ds_kll
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  c_int INT,
  c_double DOUBLE,
  c_decimal DECIMAL(10, 2),
  c_date DATE,
  c_datetime DATETIME,
  c_largeint LARGEINT,
  c_bool BOOLEAN
)
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 4;
-- result:
-- !result
insert into t1
select generate_series, generate_series, generate_series / 4, generate_series / 100,
       date_add('2024-01-01', interval generate_series day),
       date_add('2024-01-01 00:00:00', interval generate_series hour),
       cast(generate_series as largeint) * 100000000000000000000, generate_series % 2 = 0
from table(generate_series(1, 200));
-- result:
-- !result
insert into t1 values (0, null, null, null, null, null, null, null);
-- result:
-- !result
-- Below k = 400 values the sketch keeps every value, so the buckets are exact.
select ds_kll_histogram(ds_kll(c_int), 4) from t1;
-- result:
{"count":200,"min":"1","max":"200","buckets":[["1","50",0.25],["50","100",0.5],["100","150",0.75],["150","200",1]]}
-- !result
select ds_kll_histogram(ds_kll(c_double), 2) from t1;
-- result:
{"count":200,"min":"0.25","max":"50","buckets":[["0.25","25",0.5],["25","50",1]]}
-- !result
select ds_kll_histogram(ds_kll(c_decimal), 2) from t1;
-- result:
{"count":200,"min":"0.01","max":"2.00","buckets":[["0.01","1.00",0.5],["1.00","2.00",1]]}
-- !result
select ds_kll_histogram(ds_kll(c_date), 2) from t1;
-- result:
{"count":200,"min":"2024-01-02","max":"2024-07-19","buckets":[["2024-01-02","2024-04-10",0.5],["2024-04-10","2024-07-19",1]]}
-- !result
select ds_kll_histogram(ds_kll(c_datetime), 2) from t1;
-- result:
{"count":200,"min":"2024-01-01 01:00:00","max":"2024-01-09 08:00:00","buckets":[["2024-01-01 01:00:00","2024-01-05 04:00:00",0.5],["2024-01-05 04:00:00","2024-01-09 08:00:00",1]]}
-- !result
select ds_kll_histogram(ds_kll(c_largeint), 2) from t1;
-- result:
{"count":200,"min":"100000000000000000000","max":"20000000000000000000000","buckets":[["100000000000000000000","10000000000000000000000",0.5],["10000000000000000000000","20000000000000000000000",1]]}
-- !result
select ds_kll_histogram(ds_kll(c_bool), 2) from t1;
-- result:
{"count":200,"min":"0","max":"1","buckets":[["0","0",0.5],["0","1",1]]}
-- !result
select ds_kll_histogram(ds_kll(id), 1) from t1;
-- result:
{"count":201,"min":"0","max":"200","buckets":[["0","200",1]]}
-- !result
-- A group without a non-NULL value has no sketch.
select ds_kll(c_int) is null, ds_kll_histogram(ds_kll(c_int), 4) from t1 where id = 0;
-- result:
1	None
-- !result
select ds_kll(c_int) is null, ds_kll_histogram(ds_kll(c_int), 4) from t1 where id < 0;
-- result:
1	None
-- !result
-- The result does not depend on how many stages the aggregation is split into.
set new_planner_agg_stage = 1;
-- result:
-- !result
select ds_kll_histogram(ds_kll(c_int), 4) from t1;
-- result:
{"count":200,"min":"1","max":"200","buckets":[["1","50",0.25],["50","100",0.5],["100","150",0.75],["150","200",1]]}
-- !result
set new_planner_agg_stage = 2;
-- result:
-- !result
select ds_kll_histogram(ds_kll(c_int), 4) from t1;
-- result:
{"count":200,"min":"1","max":"200","buckets":[["1","50",0.25],["50","100",0.5],["100","150",0.75],["150","200",1]]}
-- !result
select id % 3 as g, ds_kll_histogram(ds_kll(c_int), 2) from t1 group by id % 3 order by g;
-- result:
0	{"count":66,"min":"3","max":"198","buckets":[["3","99",0.5],["99","198",1]]}
1	{"count":67,"min":"1","max":"199","buckets":[["1","100",0.5074626865671642],["100","199",1]]}
2	{"count":67,"min":"2","max":"200","buckets":[["2","101",0.5074626865671642],["101","200",1]]}
-- !result
set new_planner_agg_stage = 0;
-- result:
-- !result
set streaming_preaggregation_mode = 'force_streaming';
-- result:
-- !result
select id % 3 as g, ds_kll_histogram(ds_kll(c_int), 2) from t1 group by id % 3 order by g;
-- result:
0	{"count":66,"min":"3","max":"198","buckets":[["3","99",0.5],["99","198",1]]}
1	{"count":67,"min":"1","max":"199","buckets":[["1","100",0.5074626865671642],["100","199",1]]}
2	{"count":67,"min":"2","max":"200","buckets":[["2","101",0.5074626865671642],["101","200",1]]}
-- !result
set streaming_preaggregation_mode = 'auto';
-- result:
-- !result
-- ds_kll_union merges sketches that were built separately.
select ds_kll_histogram(ds_kll_union(s), 4) from (select id % 7 as g, ds_kll(c_int) as s from t1 group by id % 7) t;
-- result:
{"count":200,"min":"1","max":"200","buckets":[["1","50",0.25],["50","100",0.5],["100","150",0.75],["150","200",1]]}
-- !result
select ds_kll_histogram(ds_kll_union(s), 2) from (select id % 7 as g, ds_kll(c_date) as s from t1 group by id % 7) t;
-- result:
{"count":200,"min":"2024-01-02","max":"2024-07-19","buckets":[["2024-01-02","2024-04-10",0.5],["2024-04-10","2024-07-19",1]]}
-- !result
-- A sketch can be stored and merged later.
CREATE TABLE sketches (g INT, s VARBINARY) DUPLICATE KEY(g) DISTRIBUTED BY HASH(g) BUCKETS 1;
-- result:
-- !result
insert into sketches select id % 5, ds_kll(c_decimal) from t1 group by id % 5;
-- result:
-- !result
select count(*), ds_kll_histogram(ds_kll_union(s), 2) from sketches;
-- result:
5	{"count":200,"min":"0.01","max":"2.00","buckets":[["0.01","1.00",0.5],["1.00","2.00",1]]}
-- !result
-- Sketches of different value types do not merge.
select ds_kll_union(s) from (select ds_kll(c_int) as s from t1 union all select ds_kll(c_double) from t1) t;
-- result:
[REGEX].*ds_kll_union: expected a KLL sketch of (INT|DOUBLE) values, but got one of (INT|DOUBLE) values.*
-- !result
select ds_kll_histogram(cast('not a sketch' as varbinary), 4);
-- result:
[REGEX].*ds_kll_histogram: not a sketch of the expected kind.*
-- !result
select ds_kll_histogram(ds_kll(c_int), 0) from t1;
-- result:
[REGEX].*ds_kll_histogram: the number of buckets must be between 1 and 65536, but got 0.*
-- !result
-- Above k values the sketch samples. The bounds stay within its rank error of the ranks asked for.
CREATE TABLE t2 (id BIGINT NOT NULL, v BIGINT NOT NULL) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 4;
-- result:
-- !result
insert into t2 select generate_series, (generate_series * 7919) % 1000000 from table(generate_series(1, 1000000));
-- result:
-- !result
with h as (select ds_kll_histogram(ds_kll(v), 10) as j from t2)
select get_json_int(j, '$.count'), get_json_string(j, '$.min'), get_json_string(j, '$.max'),
       json_length(parse_json(j), '$.buckets'),
       abs(cast(get_json_string(j, '$.buckets[4][1]') as bigint) - 500000) < 30000,
       abs(get_json_double(j, '$.buckets[4][2]') - 0.5) < 0.03,
       get_json_double(j, '$.buckets[9][2]') = 1
from h;
-- result:
1000000	0	999999	10	1	1	1
-- !result
select length(ds_kll(v)) < 65536 from t2;
-- result:
1
-- !result
